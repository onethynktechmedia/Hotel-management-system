NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_KITCHEN_SECURITY_ENABLED=true

# QZ Tray Configuration for Direct Printing
# Get certificate ID from QZ Tray Settings > Certificates
NEXT_PUBLIC_QZ_CERT_ID=your_certificate_id

# Supabase Edge Function URL for secure signing
# Format: https://your-project.supabase.co/functions/v1/sign-qz
NEXT_PUBLIC_QZ_SIGNING_URL=https://your-project.supabase.co/functions/v1/sign-qz

# Default printer name (optional - can be set in UI)
# Must match exact printer name from system settings
NEXT_PUBLIC_DEFAULT_PRINTER=EPSON TM-T88V

# Development mode - DISABLE SECURITY (ONLY FOR TESTING - DO NOT USE IN PRODUCTION)
# NEXT_PUBLIC_QZ_SECURITY_DISABLED=true
