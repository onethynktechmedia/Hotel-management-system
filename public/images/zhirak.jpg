<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background with gradient -->
  <defs>
    <linearGradient id="gradzhirak_jpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F5F5DC;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#556B2F;stop-opacity:0.3" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#gradzhirak_jpg)"/>
  
  <!-- Decorative border -->
  <rect x="10" y="10" width="380" height="280" fill="none" stroke="#556B2F" stroke-width="4" rx="10" ry="10"/>
  
  <!-- Central icon circle -->
  <circle cx="200" cy="130" r="60" fill="#556B2F" opacity="0.2"/>
  <circle cx="200" cy="130" r="50" fill="#556B2F" opacity="0.3"/>
  
  <!-- Food icon (emoji) -->
  <text x="200" y="145" text-anchor="middle" font-size="48">🥬</text>
  
  <!-- Item name -->
  <text x="200" y="215" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#556B2F">
    Zhirak
  </text>
  
  <!-- Marathi name -->
  <text x="200" y="245" text-anchor="middle" font-family="Arial, sans-serif" font-size="18" fill="#556B2F" opacity="0.8">
    झिरक
  </text>
  
  <!-- Description -->
  <text x="200" y="270" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#556B2F" opacity="0.6">
    Dry vegetable
  </text>
  
  <!-- Restaurant branding -->
  <text x="200" y="290" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#556B2F" opacity="0.5">
    ढोले पाटील खानावळ
  </text>
</svg>